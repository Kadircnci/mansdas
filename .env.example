# =================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# =================================
# Bu dosyayı kopyalayıp .env.local olarak adlandırın
# ve değerleri kendi setup'ınıza göre güncelleyin

# --------------------------------
# Database Configuration
# --------------------------------
# Development için local MongoDB
MONGODB_URI=mongodb://localhost:27017/social-media-planner

# Production için MongoDB Atlas (örnek)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/social-media-planner

# --------------------------------
# Authentication
# --------------------------------
SECRET_KEY=your-super-secret-jwt-key-change-me-in-production
REFRESH_SECRET_KEY=your-super-secret-refresh-jwt-key-change-me-in-production

# --------------------------------
# Frontend Configuration
# --------------------------------
# Development
NEXT_PUBLIC_API_BASE=/api

# Production (Vercel deploy sonrası)
# NEXT_PUBLIC_API_BASE=https://your-domain.vercel.app/api

# --------------------------------
# OpenAI (Opsiyonel)
# --------------------------------
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# --------------------------------
# Social Media APIs (Opsiyonel)
# --------------------------------
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret

# --------------------------------
# Analytics (Opsiyonel)
# --------------------------------
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id