# Frontend Environment Variables for Production

# Backend API URL (Railway/Render'da deploy edilen backend)
NEXT_PUBLIC_API_BASE=https://your-backend-app.railway.app

# Database (Vercel Postgres veya başka provider)
DATABASE_URL=postgresql://username:password@hostname:port/database

# Redis (Upstash)
REDIS_URL=redis://default:password@hostname:port

# OpenAI (Production key)
OPENAI_API_KEY=your_production_openai_key

# JWT Secret (Production secret)
SECRET_KEY=your_production_secret_key

# Social Media API Keys
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret