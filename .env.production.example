# =================================# Frontend Environment Variables for Production

# PRODUCTION ENVIRONMENT VARIABLES

# =================================# Backend API URL (Railway/Render'da deploy edilen backend)

# Bu değerleri Vercel Dashboard'da Environment Variables NEXT_PUBLIC_API_BASE=https://your-backend-app.railway.app

# bölümünden ayarlayın

# Database (Vercel Postgres veya başka provider)

# --------------------------------DATABASE_URL=postgresql://username:password@hostname:port/database

# Database Configuration (Required)

# --------------------------------# Redis (Upstash)

# MongoDB Atlas connection stringREDIS_URL=redis://default:password@hostname:port

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/social-media-planner

# OpenAI (Production key)

# --------------------------------OPENAI_API_KEY=your_production_openai_key

# Authentication (Required)

# --------------------------------# JWT Secret (Production secret)

# Güçlü bir secret key generate edinSECRET_KEY=your_production_secret_key

SECRET_KEY=your-super-strong-production-secret-key-min-32-chars

# Social Media API Keys

# --------------------------------INSTAGRAM_CLIENT_ID=your_instagram_client_id

# Frontend Configuration (Required)INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
# --------------------------------
# Production domain'iniz
NEXT_PUBLIC_API_BASE=https://your-app.vercel.app/api

# --------------------------------
# OpenAI (Opsiyonel)
# --------------------------------
OPENAI_API_KEY=sk-your-production-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# --------------------------------
# Social Media APIs (Opsiyonel)
# --------------------------------
INSTAGRAM_CLIENT_ID=your_production_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_production_instagram_client_secret

# --------------------------------
# Analytics (Opsiyonel)
# --------------------------------
NEXT_PUBLIC_ANALYTICS_ID=your_production_analytics_id

# --------------------------------
# Vercel Specific (Otomatik)
# --------------------------------
# Bu değerler Vercel tarafından otomatik set edilir
# VERCEL_URL
# VERCEL_ENV